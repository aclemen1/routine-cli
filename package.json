{
  "name": "routine-cli",
  "version": "0.1.0",
  "description": "Run scheduled routines (commands or ACP agent prompts) described by Markdown files with RRULE schedules",
  "type": "module",
  "bin": {
    "routine": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test 'src/**/*.test.ts'"
  },
  "engines": {
    "node": ">=22.18"
  },
  "author": "Alain Clément",
  "license": "Apache-2.0",
  "dependencies": {
    "rrule-temporal": "^2.2.8",
    "temporal-polyfill": "^1.0.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
